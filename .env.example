# PharmaChain configuration. The start scripts copy this to .env automatically.
# Leave APP_HOST blank to auto-detect your LAN IP (used inside QR codes).
APP_HOST=
API_PORT=4000
FRONTEND_PORT=5173
JWT_SECRET=change-this-demo-secret
JWT_EXPIRES_IN=8h
# auto = use Fabric if reachable, otherwise DEMO MODE. Use "fabric" to force Fabric, "demo" to force demo.
FABRIC_MODE=auto
CHANNEL_NAME=mychannel
CHAINCODE_NAME=drugcontract
# Default Fabric location is ~/fabric-samples. Uncomment to change (no $HOME or ~ here):
# FABRIC_PATH=/Users/yourname/fabric-samples
